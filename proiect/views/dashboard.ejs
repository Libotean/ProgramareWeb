<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= theme === 'dark' ? 'dark' : '' %>">

<div class="topbar">
    <div class="topbar-brand">budget<span>.</span></div>
    <div class="topbar-right">
        <a href="/budget/rapoarte">Rapoarte</a>
        <span>Bun venit, <strong><%= user.username %></strong></span>
        <a href="/logout">Logout</a>
    </div>
</div>

<div class="main">

    <!-- Navigare luna -->
    <%
        const prevLuna = luna === 1 ? 12 : luna - 1;
        const prevAn = luna === 1 ? an - 1 : an;
        const nextLuna = luna === 12 ? 1 : luna + 1;
        const nextAn = luna === 12 ? an + 1 : an;
    %>
    <div class="month-nav">
        <a href="/budget?luna=<%= prevLuna %>&an=<%= prevAn %>">&#8592;</a>
        <h2><%= lunaText %> <%= an %></h2>
        <a href="/budget?luna=<%= nextLuna %>&an=<%= nextAn %>">&#8594;</a>
    </div>

    <!-- Alert recurente -->
    <% if (areRecurenteNeaplicate) { %>
        <div class="alert-recurente">
            <span>Ai cheltuieli recurente care nu au fost aplicate pentru luna aceasta.</span>
            <form method="POST" action="/budget/aplica-recurente" style="display:inline;">
                <button type="submit" class="btn-aplica">Aplica template</button>
            </form>
        </div>
    <% } %>

    <!-- Metrici -->
    <div class="metrics">
        <div class="metric">
            <label>Total alocat</label>
            <div class="val accent"><%= totalAlocat.toFixed(2) %> lei</div>
        </div>
        <div class="metric">
            <label>Total cheltuit</label>
            <div class="val <%= totalCheltuit > totalAlocat ? 'danger' : '' %>"><%= totalCheltuit.toFixed(2) %> lei</div>
        </div>
        <div class="metric">
            <label>Rămas</label>
            <div class="val <%= ramas < 0 ? 'danger' : 'ok' %>"><%= ramas.toFixed(2) %> lei</div>
        </div>
    </div>

    <!-- Adauga categorie -->
    <p class="section-label">Categorie noua</p>
    <div class="add-card">
        <form method="POST" action="/budget/add-budget?luna=<%= luna %>&an=<%= an %>">
            <div class="row g-2 align-items-end">
                <div class="col-4">
                    <label style="font-size:0.78rem;color:#6b6b6b;display:block;margin-bottom:4px;">Categorie</label>
                    <input type="text" name="categorie" placeholder="ex: Mancare, Gaz..." required>
                </div>
                <div class="col-3">
                    <label style="font-size:0.78rem;color:#6b6b6b;display:block;margin-bottom:4px;">Buget alocat (lei)</label>
                    <input type="number" name="alocat" placeholder="500" min="0" step="0.01" required>
                </div>
                <div class="col-2">
                    <label style="font-size:0.78rem;color:#6b6b6b;display:block;margin-bottom:4px;">Tip</label>
                    <select name="tip">
                        <option value="variabil">Variabil</option>
                        <option value="fix">Fix</option>
                    </select>
                </div>
                <div class="col-3 d-flex flex-column gap-1">
                    <div class="recurent-row">
                        <input type="checkbox" name="recurent" id="recurent">
                        <label for="recurent" style="margin:0;cursor:pointer;">Recurenta lunar</label>
                    </div>
                    <button type="submit" class="btn-add">+ Adauga</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Lista bugete -->
    <p class="section-label">Cheltuielile tale</p>

    <% if (budgets.length === 0) { %>
        <div class="empty-state">Nicio categorie pentru <%= lunaText %> <%= an %>. Adauga una mai sus.</div>
    <% } %>

    <% budgets.forEach(b => { %>
        <%
            const pct = b.alocat > 0 ? Math.min((b.cheltuit / b.alocat) * 100, 100) : 0;
            const overBudget = b.cheltuit > b.alocat;
            const barClass = overBudget ? 'danger' : (pct > 75 ? '' : 'ok');
        %>
        <div class="budget-block">
            <div class="budget-header">
                <div>
                    <span class="budget-name"><%= b.categorie %></span>
                    <div class="budget-badges d-inline-flex ms-2">
                        <span class="budget-tip"><%= b.tip %></span>
                        <% if (b.recurent) { %><span class="budget-recurent">recurent</span><% } %>
                    </div>
                </div>
                <div class="budget-nums">
                    <strong><%= b.cheltuit.toFixed(2) %></strong> / <%= b.alocat.toFixed(2) %> lei
                </div>
                <div class="budget-actions">
                    <button class="btn-edit-toggle" onclick="toggleEdit('<%= b._id %>')">Editeaza</button>
                    <form method="POST" action="/budget/delete-budget/<%= b._id %>" style="display:inline;" onsubmit="return confirm('Stergi categoria si toate tranzactiile ei?')">
                        <input type="hidden" name="luna" value="<%= luna %>">
                        <input type="hidden" name="an" value="<%= an %>">
                        <button type="submit" class="btn-del">✕</button>
                    </form>
                </div>
            </div>

            <!-- Edit form -->
            <div class="edit-form" id="edit-<%= b._id %>">
                <form method="POST" action="/budget/edit-budget/<%= b._id %>" style="display:flex;gap:8px;align-items:center;">
                    <input type="number" name="alocat" value="<%= b.alocat %>" min="0" step="0.01" required>
                    <input type="hidden" name="luna" value="<%= luna %>">
                    <input type="hidden" name="an" value="<%= an %>">
                    <button type="submit" class="btn-save">Salvează</button>
                </form>
            </div>

            <!-- Progress bar -->
            <div class="progress-wrap">
                <div class="progress-bar <%= barClass %>" style="width: <%= pct %>%"></div>
            </div>

            <!-- Tranzactii -->
            <div class="transactions">
                <% if (b.tranzactii.length === 0) { %>
                    <p style="font-size:0.8rem;color:#bbb;margin-bottom:0.5rem;">Nicio tranzactie inca.</p>
                <% } %>
                <% b.tranzactii.forEach(t => { %>
                    <div class="tx-row">
                        <span class="tx-desc">
                            <%= t.descriere %>
                            <span class="tx-date"><%= new Date(t.data).toLocaleDateString('ro-RO') %></span>
                        </span>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span class="tx-suma"><%= t.suma.toFixed(2) %> lei</span>
                            <form method="POST" action="/budget/delete-transaction/<%= t._id %>" style="display:inline;">
                                <input type="hidden" name="luna" value="<%= luna %>">
                                <input type="hidden" name="an" value="<%= an %>">
                                <button type="submit" class="btn-del">✕</button>
                            </form>
                        </div>
                    </div>
                <% }) %>

                <form method="POST" action="/budget/add-transaction/<%= b._id %>" class="tx-add-form">
                    <input type="text" name="descriere" placeholder="Descriere" required>
                    <input type="number" name="suma" placeholder="Lei" min="0" step="0.01" required style="max-width:100px;">
                    <input type="hidden" name="luna" value="<%= luna %>">
                    <input type="hidden" name="an" value="<%= an %>">
                    <button type="submit" class="btn-tx-add">+ Adauga</button>
                </form>
            </div>
        </div>
    <% }) %>

    <!-- Bottom bar -->
    <div class="bottom-bar">
        <form method="POST" action="/budget/set-theme" style="display:flex;align-items:center;gap:8px;">
            <span>Tema:</span>
            <select name="theme" onchange="this.form.submit()">
                <option value="light" <%= theme === 'light' ? 'selected' : '' %>>Light</option>
                <option value="dark" <%= theme === 'dark' ? 'selected' : '' %>>Dark</option>
            </select>
            <input type="hidden" name="luna" value="<%= luna %>">
            <input type="hidden" name="an" value="<%= an %>">
        </form>
    </div>

</div>

<script>
    function toggleEdit(id) {
        const el = document.getElementById('edit-' + id);
        el.classList.toggle('open');
    }
</script>

</body>
</html>