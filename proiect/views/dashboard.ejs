<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { background: #f8f8f6; font-family: 'Segoe UI', sans-serif; color: #1a1a1a; }

        .topbar { background: #fff; border-bottom: 1px solid #e8e8e4; padding: 14px 2rem; display: flex; justify-content: space-between; align-items: center; }
        .topbar-brand { font-size: 1rem; font-weight: 600; letter-spacing: -0.3px; color: #1a1a1a; }
        .topbar-brand span { color: #e07b2a; }
        .topbar-right { display: flex; align-items: center; gap: 12px; font-size: 0.83rem; color: #6b6b6b; }
        .topbar-right a { color: #1a1a1a; text-decoration: none; font-size: 0.83rem; border: 1px solid #e0e0dc; border-radius: 7px; padding: 5px 14px; }
        .topbar-right a:hover { background: #f0f0ec; }

        .main { max-width: 860px; margin: 0 auto; padding: 2rem 1rem; }

        .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 2rem; }
        .metric { background: #fff; border: 1px solid #e8e8e4; border-radius: 10px; padding: 1.1rem 1.25rem; }
        .metric label { font-size: 0.75rem; color: #6b6b6b; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
        .metric .val { font-size: 1.5rem; font-weight: 500; color: #1a1a1a; }
        .metric .val.ok { color: #2a7a4b; }
        .metric .val.danger { color: #c0392b; }
        .metric .val.accent { color: #e07b2a; }

        .section-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #6b6b6b; margin-bottom: 0.75rem; }

        .add-card { background: #fff; border: 1px solid #e8e8e4; border-radius: 10px; padding: 1.25rem; margin-bottom: 2rem; }
        .add-card input, .add-card select { border: 1px solid #e0e0dc; border-radius: 8px; font-size: 0.87rem; padding: 8px 12px; background: #fafaf8; color: #1a1a1a; width: 100%; }
        .add-card input:focus, .add-card select:focus { border-color: #e07b2a; outline: none; box-shadow: 0 0 0 3px rgba(224,123,42,0.1); }
        .btn-add { background: #e07b2a; color: #fff; border: none; border-radius: 8px; padding: 8px 20px; font-size: 0.87rem; cursor: pointer; white-space: nowrap; }
        .btn-add:hover { background: #c96d20; }

        .budget-block { background: #fff; border: 1px solid #e8e8e4; border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
        .budget-header { padding: 1rem 1.25rem; display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 16px; }
        .budget-name { font-size: 0.95rem; font-weight: 500; }
        .budget-tip { font-size: 0.72rem; color: #6b6b6b; border: 1px solid #e0e0dc; border-radius: 20px; padding: 2px 10px; }
        .budget-nums { font-size: 0.83rem; color: #6b6b6b; }
        .budget-nums strong { color: #1a1a1a; }
        .progress-wrap { height: 4px; background: #f0f0ec; margin: 0 1.25rem; border-radius: 99px; overflow: hidden; }
        .progress-bar { height: 100%; border-radius: 99px; background: #e07b2a; transition: width 0.3s; }
        .progress-bar.ok { background: #2a7a4b; }
        .progress-bar.danger { background: #c0392b; }

        .transactions { padding: 0.75rem 1.25rem 1rem; border-top: 1px solid #f0f0ec; margin-top: 0.75rem; }
        .tx-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f5f5f2; font-size: 0.85rem; }
        .tx-row:last-child { border-bottom: none; }
        .tx-desc { color: #1a1a1a; }
        .tx-date { font-size: 0.75rem; color: #9b9b9b; margin-left: 8px; }
        .tx-suma { font-weight: 500; color: #e07b2a; }
        .btn-del { background: none; border: none; color: #ccc; cursor: pointer; font-size: 0.85rem; padding: 2px 6px; border-radius: 5px; }
        .btn-del:hover { color: #c0392b; background: #fff5f5; }

        .tx-add-form { display: flex; gap: 8px; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid #f0f0ec; }
        .tx-add-form input { flex: 1; border: 1px solid #e0e0dc; border-radius: 7px; font-size: 0.83rem; padding: 6px 10px; background: #fafaf8; }
        .tx-add-form input:focus { border-color: #e07b2a; outline: none; }
        .btn-tx-add { background: #1a1a1a; color: #fff; border: none; border-radius: 7px; padding: 6px 14px; font-size: 0.83rem; cursor: pointer; }
        .btn-tx-add:hover { background: #333; }

        .budget-actions { display: flex; gap-6px; align-items: center; gap: 6px; }
        .btn-edit-toggle { background: none; border: 1px solid #e0e0dc; border-radius: 7px; font-size: 0.78rem; color: #6b6b6b; padding: 4px 10px; cursor: pointer; }
        .btn-edit-toggle:hover { border-color: #e07b2a; color: #e07b2a; }
        .edit-form { display: none; gap: 8px; margin: 0.5rem 1.25rem 0.75rem; align-items: center; }
        .edit-form.open { display: flex; }
        .edit-form input { border: 1px solid #e0e0dc; border-radius: 7px; font-size: 0.83rem; padding: 6px 10px; background: #fafaf8; width: 140px; }
        .edit-form input:focus { border-color: #e07b2a; outline: none; }
        .btn-save { background: #e07b2a; color: #fff; border: none; border-radius: 7px; padding: 6px 14px; font-size: 0.83rem; cursor: pointer; }

        .empty-state { text-align: center; padding: 3rem 1rem; color: #9b9b9b; font-size: 0.9rem; }

        .theme-row { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid #e8e8e4; display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: #9b9b9b; }
        .theme-row select { font-size: 0.8rem; border: 1px solid #e0e0dc; border-radius: 6px; padding: 4px 8px; background: #fafaf8; color: #1a1a1a; }
        .views-badge { margin-left: auto; font-size: 0.75rem; color: #bbb; }
    </style>
</head>
<body>

<div class="topbar">
    <div class="topbar-brand">budget<span>.</span></div>
    <div class="topbar-right">
        <span>Bun venit, <strong><%= user.username %></strong></span>
        <a href="/logout">Delogare</a>
    </div>
</div>

<div class="main">

    <!-- Metrici -->
    <div class="metrics">
        <div class="metric">
            <label>Total alocat</label>
            <div class="val accent"><%= totalAlocat.toFixed(2) %> lei</div>
        </div>
        <div class="metric">
            <label>Total cheltuit</label>
            <div class="val <%= totalCheltuit > totalAlocat ? 'danger' : '' %>"><%= totalCheltuit.toFixed(2) %> lei</div>
        </div>
        <div class="metric">
            <label>Rămas</label>
            <div class="val <%= ramas < 0 ? 'danger' : 'ok' %>"><%= ramas.toFixed(2) %> lei</div>
        </div>
    </div>

    <!-- Adaugă categorie -->
    <p class="section-label">Categorie nouă</p>
    <div class="add-card">
        <form method="POST" action="/budget/add-budget">
            <div class="row g-2 align-items-end">
                <div class="col-5">
                    <label style="font-size:0.78rem;color:#6b6b6b;display:block;margin-bottom:4px;">Categorie</label>
                    <input type="text" name="categorie" placeholder="ex: Mâncare, Gaz..." required>
                </div>
                <div class="col-3">
                    <label style="font-size:0.78rem;color:#6b6b6b;display:block;margin-bottom:4px;">Buget alocat (lei)</label>
                    <input type="number" name="alocat" placeholder="500" min="0" step="0.01" required>
                </div>
                <div class="col-2">
                    <label style="font-size:0.78rem;color:#6b6b6b;display:block;margin-bottom:4px;">Tip</label>
                    <select name="tip">
                        <option value="variabil">Variabil</option>
                        <option value="fix">Fix</option>
                    </select>
                </div>
                <div class="col-2">
                    <button type="submit" class="btn-add w-100">+ Adaugă</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Lista bugete -->
    <p class="section-label">Cheltuielile tale</p>

    <% if (budgets.length === 0) { %>
        <div class="empty-state">Nicio categorie încă. Adaugă una mai sus.</div>
    <% } %>

    <% budgets.forEach(b => { %>
        <%
            const pct = b.alocat > 0 ? Math.min((b.cheltuit / b.alocat) * 100, 100) : 0;
            const overBudget = b.cheltuit > b.alocat;
            const barClass = overBudget ? 'danger' : (pct > 75 ? '' : 'ok');
        %>
        <div class="budget-block">
            <div class="budget-header">
                <div>
                    <span class="budget-name"><%= b.categorie %></span>
                    <span class="budget-tip ms-2"><%= b.tip %></span>
                </div>
                <div class="budget-nums">
                    <strong><%= b.cheltuit.toFixed(2) %></strong> / <%= b.alocat.toFixed(2) %> lei
                </div>
                <div class="budget-actions">
                    <button class="btn-edit-toggle" onclick="toggleEdit('<%= b._id %>')">Editează</button>
                    <form method="POST" action="/budget/delete-budget/<%= b._id %>" style="display:inline;" onsubmit="return confirm('Ștergi categoria și toate tranzacțiile ei?')">
                        <button type="submit" class="btn-del">✕</button>
                    </form>
                </div>
            </div>

            <!-- Edit form -->
            <div class="edit-form" id="edit-<%= b._id %>">
                <form method="POST" action="/budget/edit-budget/<%= b._id %>" style="display:flex;gap:8px;align-items:center;">
                    <input type="number" name="alocat" value="<%= b.alocat %>" min="0" step="0.01" required>
                    <button type="submit" class="btn-save">Salvează</button>
                </form>
            </div>

            <!-- Progress bar -->
            <div class="progress-wrap">
                <div class="progress-bar <%= barClass %>" style="width: <%= pct %>%"></div>
            </div>

            <!-- Tranzactii -->
            <div class="transactions">
                <% if (b.tranzactii.length === 0) { %>
                    <p style="font-size:0.8rem;color:#bbb;margin-bottom:0.5rem;">Nicio tranzacție încă.</p>
                <% } %>
                <% b.tranzactii.forEach(t => { %>
                    <div class="tx-row">
                        <span class="tx-desc">
                            <%= t.descriere %>
                            <span class="tx-date"><%= new Date(t.data).toLocaleDateString('ro-RO') %></span>
                        </span>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span class="tx-suma"><%= t.suma.toFixed(2) %> lei</span>
                            <form method="POST" action="/budget/delete-transaction/<%= t._id %>" style="display:inline;">
                                <button type="submit" class="btn-del">✕</button>
                            </form>
                        </div>
                    </div>
                <% }) %>

                <!-- Adaugă tranzacție -->
                <form method="POST" action="/budget/add-transaction/<%= b._id %>" class="tx-add-form">
                    <input type="text" name="descriere" placeholder="Descriere (ex: Lidl)" required>
                    <input type="number" name="suma" placeholder="Lei" min="0" step="0.01" required style="max-width:100px;">
                    <button type="submit" class="btn-tx-add">+ Adaugă</button>
                </form>
            </div>
        </div>
    <% }) %>

    <!-- Tema + vizite -->
    <div class="theme-row">
        <form method="POST" action="/budget/set-theme" style="display:flex;align-items:center;gap:8px;">
            <span>Temă:</span>
            <select name="theme" onchange="this.form.submit()">
                <option value="light" <%= theme === 'light' ? 'selected' : '' %>>Light</option>
                <option value="dark" <%= theme === 'dark' ? 'selected' : '' %>>Dark</option>
            </select>
        </form>
        <span class="views-badge">Vizite sesiune: <%= views %></span>
    </div>

</div>

<script>
    function toggleEdit(id) {
        const el = document.getElementById('edit-' + id);
        el.classList.toggle('open');
    }
</script>

</body>
</html>