<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard · Budget</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= theme === 'dark' ? 'dark' : '' %>">

<header class="topbar">
    <a href="/" class="topbar-brand">budget<span>.</span></a>
    <button class="nav-toggle" type="button" aria-label="Meniu" aria-expanded="false" onclick="toggleNav(this)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>
    <nav class="topbar-right" id="topbarNav">
        <span class="topbar-greeting">Bun venit, <strong><%= user.username %></strong></span>
        <a href="/budget/rapoarte">Rapoarte</a>
        <a href="/logout">Logout</a>
    </nav>
</header>

<div class="main">

    <!-- Navigare luna -->
    <%
        const prevLuna = luna === 1 ? 12 : luna - 1;
        const prevAn = luna === 1 ? an - 1 : an;
        const nextLuna = luna === 12 ? 1 : luna + 1;
        const nextAn = luna === 12 ? an + 1 : an;
    %>
    <nav class="month-nav" aria-label="Navigare luna">
        <a href="/budget?luna=<%= prevLuna %>&an=<%= prevAn %>" aria-label="Luna anterioara">&#8592;</a>
        <h2><%= lunaText %> <%= an %></h2>
        <a href="/budget?luna=<%= nextLuna %>&an=<%= nextAn %>" aria-label="Luna urmatoare">&#8594;</a>
    </nav>

    <!-- Alert recurente -->
    <% if (areRecurenteNeaplicate) { %>
        <div class="alert-recurente" role="status">
            <span>Ai cheltuieli recurente care nu au fost aplicate pentru luna aceasta.</span>
            <form method="POST" action="/budget/aplica-recurente" style="margin:0;">
                <button type="submit" class="btn-aplica">Aplica template</button>
            </form>
        </div>
    <% } %>

    <!-- Metrici -->
    <section class="metrics" aria-label="Sumar luna">
        <div class="metric">
            <label>Total alocat</label>
            <div class="val accent"><%= totalAlocat.toFixed(2) %> lei</div>
        </div>
        <div class="metric">
            <label>Total cheltuit</label>
            <div class="val <%= totalCheltuit > totalAlocat ? 'danger' : '' %>"><%= totalCheltuit.toFixed(2) %> lei</div>
        </div>
        <div class="metric">
            <label>Ramas</label>
            <div class="val <%= ramas < 0 ? 'danger' : 'ok' %>"><%= ramas.toFixed(2) %> lei</div>
        </div>
    </section>

    <!-- Adauga categorie -->
    <p class="section-label">Categorie noua</p>
    <div class="add-card">
        <form method="POST" action="/budget/add-budget?luna=<%= luna %>&an=<%= an %>">
            <div class="row g-2 align-items-end" style="display:grid;grid-template-columns:repeat(12,1fr);gap:12px;">
                <div style="grid-column:span 5;">
                    <label class="field-label" for="categorie">Categorie</label>
                    <input id="categorie" type="text" name="categorie" placeholder="ex: Mancare, Gaz..." required>
                </div>
                <div style="grid-column:span 4;">
                    <label class="field-label" for="alocat">Buget alocat (lei)</label>
                    <input id="alocat" type="number" name="alocat" placeholder="500" min="0" step="0.01" required>
                </div>
                <div style="grid-column:span 3;">
                    <label class="field-label" for="tip">Tip</label>
                    <select id="tip" name="tip">
                        <option value="variabil">Variabil</option>
                        <option value="fix">Fix</option>
                    </select>
                </div>
                <div style="grid-column:span 12;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-top:4px;">
                    <div class="recurent-row">
                        <input type="checkbox" name="recurent" id="recurent">
                        <label for="recurent" style="margin:0;cursor:pointer;">Recurenta lunar</label>
                    </div>
                    <button type="submit" class="btn-add">+ Adauga categorie</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Lista bugete -->
    <p class="section-label">Cheltuielile tale</p>

    <% if (budgets.length === 0) { %>
        <div class="empty-state">Nicio categorie pentru <%= lunaText %> <%= an %>. Adauga una mai sus.</div>
    <% } %>

    <% budgets.forEach(b => { %>
        <%
            const pct = b.alocat > 0 ? Math.min((b.cheltuit / b.alocat) * 100, 100) : 0;
            const overBudget = b.cheltuit > b.alocat;
            const barClass = overBudget ? 'danger' : (pct > 75 ? '' : 'ok');
        %>
        <article class="budget-block">
            <header class="budget-header">
                <div class="budget-id">
                    <span class="budget-name"><%= b.categorie %></span>
                    <div class="budget-badges">
                        <span class="budget-tip"><%= b.tip %></span>
                        <% if (b.recurent) { %><span class="budget-recurent">recurent</span><% } %>
                    </div>
                </div>
                <div class="budget-nums">
                    <strong><%= b.cheltuit.toFixed(2) %></strong> / <%= b.alocat.toFixed(2) %> lei
                </div>
                <div class="budget-actions">
                    <button type="button" class="btn-edit-toggle" onclick="toggleEdit('<%= b._id %>')">Editeaza</button>
                    <form method="POST" action="/budget/delete-budget/<%= b._id %>" style="display:inline;margin:0;" onsubmit="return confirm('Stergi categoria si toate tranzactiile ei?')">
                        <input type="hidden" name="luna" value="<%= luna %>">
                        <input type="hidden" name="an" value="<%= an %>">
                        <button type="submit" class="btn-del" aria-label="Sterge categoria">✕</button>
                    </form>
                </div>
            </header>

            <!-- Edit form -->
            <div class="edit-form" id="edit-<%= b._id %>">
                <form method="POST" action="/budget/edit-budget/<%= b._id %>" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0;">
                    <input type="number" name="alocat" value="<%= b.alocat %>" min="0" step="0.01" required>
                    <input type="hidden" name="luna" value="<%= luna %>">
                    <input type="hidden" name="an" value="<%= an %>">
                    <button type="submit" class="btn-save">Salveaza</button>
                </form>
            </div>

            <!-- Progress bar -->
            <div class="budget-progress-wrap">
                <div class="progress-wrap" role="progressbar" aria-valuenow="<%= Math.round(pct) %>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar <%= barClass %>" style="width: <%= pct %>%"></div>
                </div>
            </div>

            <!-- Tranzactii -->
            <div class="transactions">
                <% if (b.tranzactii.length === 0) { %>
                    <p class="tx-empty">Nicio tranzactie inca.</p>
                <% } %>
                <% b.tranzactii.forEach(t => { %>
                    <div class="tx-row">
                        <span class="tx-desc">
                            <span class="tx-desc-label"><%= t.descriere %></span>
                            <span class="tx-date"><%= new Date(t.data).toLocaleDateString('ro-RO') %></span>
                        </span>
                        <div class="tx-right">
                            <span class="tx-suma"><%= t.suma.toFixed(2) %> lei</span>
                            <form method="POST" action="/budget/delete-transaction/<%= t._id %>" style="display:inline;margin:0;">
                                <input type="hidden" name="luna" value="<%= luna %>">
                                <input type="hidden" name="an" value="<%= an %>">
                                <button type="submit" class="btn-del" aria-label="Sterge tranzactia">✕</button>
                            </form>
                        </div>
                    </div>
                <% }) %>

                <form method="POST" action="/budget/add-transaction/<%= b._id %>" class="tx-add-form">
                    <input type="text" name="descriere" placeholder="Descriere" required>
                    <input type="number" name="suma" placeholder="Lei" min="0" step="0.01" required>
                    <input type="hidden" name="luna" value="<%= luna %>">
                    <input type="hidden" name="an" value="<%= an %>">
                    <button type="submit" class="btn-tx-add">+ Adauga</button>
                </form>
            </div>
        </article>
    <% }) %>

    <!-- Bottom bar -->
    <div class="bottom-bar">
        <form method="POST" action="/budget/set-theme" style="display:flex;align-items:center;gap:8px;margin:0;">
            <label for="theme-select">Tema:</label>
            <select id="theme-select" name="theme" onchange="this.form.submit()">
                <option value="light" <%= theme === 'light' ? 'selected' : '' %>>Light</option>
                <option value="dark" <%= theme === 'dark' ? 'selected' : '' %>>Dark</option>
            </select>
            <input type="hidden" name="luna" value="<%= luna %>">
            <input type="hidden" name="an" value="<%= an %>">
        </form>
    </div>

</div>

<script>
    function toggleEdit(id) {
        const el = document.getElementById('edit-' + id);
        el.classList.toggle('open');
    }
    function toggleNav(btn) {
        const nav = document.getElementById('topbarNav');
        const open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
</script>

</body>
</html>
