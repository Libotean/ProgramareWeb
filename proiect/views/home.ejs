<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f8f6; font-family: 'Segoe UI', sans-serif; }
        .hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
        h1 { font-size: 2.2rem; font-weight: 500; letter-spacing: -0.5px; color: #1a1a1a; }
        p { color: #6b6b6b; font-size: 1rem; margin-top: 0.5rem; }
        .btn-dark-custom { background: #1a1a1a; color: #fff; border: none; padding: 10px 28px; border-radius: 8px; font-size: 0.9rem; text-decoration: none; }
        .btn-outline-custom { background: transparent; color: #1a1a1a; border: 1px solid #ccc; padding: 10px 28px; border-radius: 8px; font-size: 0.9rem; text-decoration: none; }
        .btn-dark-custom:hover { background: #333; color: #fff; }
        .btn-outline-custom:hover { border-color: #1a1a1a; }
    </style>
</head>
<body>
    <div class="hero">
        <h1>Budget Planner</h1>
        <p>Ține-ți cheltuielile sub control, simplu și clar.</p>
        <div class="d-flex gap-3 mt-4">
            <% if (user) { %>
                <a href="/budget" class="btn-dark-custom">Dashboard</a>
            <% } else { %>
                <a href="/register" class="btn-dark-custom">Incepe</a>
                <a href="/login" class="btn-outline-custom">Autentificare</a>
            <% } %>
        </div>
    </div>
</body>
</html>