<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inregistrare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="center-page">
    <div class="form-card">
        <h2>Cont nou</h2>
        <p class="subtitle">Completeaza datele pentru a incepe.</p>
        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>
        <form method="POST" action="/register">
            <div class="mb-3">
                <label>Nume utilizator</label>
                <input type="text" name="username" class="form-control" placeholder="John Doe" required>
            </div>
            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" placeholder="email@exemplu.com" required>
            </div>
            <div class="mb-3">
                <label>Parola</label>
                <input type="password" name="password" class="form-control" placeholder="minim 6 caractere" required>
            </div>
            <button type="submit" class="btn-submit">Creeaza cont</button>
        </form>
        <div class="bottom-link">Ai deja cont? <a href="/login">Autentifica-te</a></div>
    </div>
</body>
</html>