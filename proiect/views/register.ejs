<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Înregistrare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f8f6; font-family: 'Segoe UI', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .form-card { background: #fff; border: 1px solid #e8e8e4; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 400px; }
        h2 { font-size: 1.4rem; font-weight: 500; color: #1a1a1a; margin-bottom: 0.25rem; }
        .subtitle { font-size: 0.85rem; color: #6b6b6b; margin-bottom: 1.75rem; }
        label { font-size: 0.82rem; color: #444; font-weight: 500; margin-bottom: 4px; }
        .form-control { border: 1px solid #e0e0dc; border-radius: 8px; font-size: 0.9rem; padding: 10px 14px; background: #fafaf8; }
        .form-control:focus { border-color: #1a1a1a; box-shadow: none; background: #fff; }
        .btn-submit { background: #1a1a1a; color: #fff; border: none; width: 100%; padding: 11px; border-radius: 8px; font-size: 0.9rem; margin-top: 0.5rem; }
        .btn-submit:hover { background: #333; color: #fff; }
        .bottom-link { text-align: center; margin-top: 1.25rem; font-size: 0.83rem; color: #6b6b6b; }
        .bottom-link a { color: #1a1a1a; text-decoration: none; font-weight: 500; }
        .error-msg { background: #fff5f5; border: 1px solid #fcc; border-radius: 8px; color: #a33; font-size: 0.83rem; padding: 10px 14px; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <div class="form-card">
        <h2>Cont nou</h2>
        <p class="subtitle">Completează datele pentru a începe.</p>
        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>
        <form method="POST" action="/register">
            <div class="mb-3">
                <label>Nume utilizator</label>
                <input type="text" name="username" class="form-control" placeholder="ex: libo" required>
            </div>
            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" placeholder="email@exemplu.com" required>
            </div>
            <div class="mb-3">
                <label>Parolă</label>
                <input type="password" name="password" class="form-control" placeholder="minim 6 caractere" required>
            </div>
            <button type="submit" class="btn-submit">Creează cont</button>
        </form>
        <div class="bottom-link">Ai deja cont? <a href="/login">Autentifică-te</a></div>
    </div>
</body>
</html>