<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rapoarte · Budget</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= theme === 'dark' ? 'dark' : '' %>">

<header class="topbar">
    <a href="/" class="topbar-brand">budget<span>.</span></a>
    <button class="nav-toggle" type="button" aria-label="Meniu" aria-expanded="false" onclick="toggleNav(this)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>
    <nav class="topbar-right" id="topbarNav">
        <a href="/budget">Dashboard</a>
        <a href="/logout">Logout</a>
    </nav>
</header>

<div class="main">
    <h1 class="page-title">Rapoarte lunare</h1>

    <% if (rapoarte.length === 0) { %>
        <div class="empty-state">Niciun raport disponibil inca.</div>
    <% } else { %>

    <!-- Chart global -->
    <section class="global-card">
        <h3>Toate cheltuielile per categorie</h3>
        <div class="global-chart-wrap">
            <canvas id="chartGlobal"></canvas>
        </div>
    </section>

    <!-- Rapoarte per luna -->
    <% rapoarte.forEach((r, i) => { %>
        <%
            const surplus = r.totalAlocat - r.totalCheltuit;
            const depasit = r.totalCheltuit > r.totalAlocat;
        %>
        <article class="raport-block">
            <button class="raport-header" type="button" onclick="toggleRaport(<%= i %>)" aria-expanded="false" aria-controls="raport-<%= i %>">
                <span class="raport-luna"><%= r.lunaText %> <%= r.an %></span>
                <div class="raport-summary">
                    <span>Alocat: <span class="accent"><%= r.totalAlocat.toFixed(2) %> lei</span></span>
                    <span>Cheltuit: <span class="<%= depasit ? 'danger' : '' %>"><%= r.totalCheltuit.toFixed(2) %> lei</span></span>
                    <span class="<%= depasit ? 'danger' : 'ok' %>"><%= depasit ? '-' : '+' %><%= Math.abs(surplus).toFixed(2) %> lei</span>
                    <span class="chevron" id="chevron-<%= i %>">&#9660;</span>
                </div>
            </button>

            <div class="raport-body" id="raport-<%= i %>">
                <div class="raport-inner">
                    <div class="cat-list">
                        <% r.categorii.forEach(c => { %>
                            <%
                                const pct = c.alocat > 0 ? Math.min((c.cheltuit / c.alocat) * 100, 100) : 0;
                                const over = c.cheltuit > c.alocat;
                                const barClass = over ? 'danger' : (pct > 75 ? '' : 'ok');
                            %>
                            <div class="cat-row">
                                <div class="cat-top">
                                    <span class="cat-name"><%= c.categorie %></span>
                                    <span class="cat-nums">
                                        <strong><%= c.cheltuit.toFixed(2) %></strong> / <%= c.alocat.toFixed(2) %> lei
                                    </span>
                                </div>
                                <div class="progress-wrap" role="progressbar" aria-valuenow="<%= Math.round(pct) %>" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar <%= barClass %>" style="width:<%= pct %>%"></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <div class="chart-side">
                        <canvas id="chart-<%= i %>"></canvas>
                    </div>
                </div>
            </div>
        </article>
    <% }) %>

    <% } %>
</div>

<script>
    const isDark = document.body.classList.contains('dark');
    const textColor = isDark ? '#a1a09b' : '#6b6b6b';
    const borderColor = isDark ? '#1c1c1b' : '#fff';

    const CULORI = [
        '#e07b2a', '#2a7a4b', '#3a7fc1', '#c0392b',
        '#8e44ad', '#16a085', '#d4ac0d', '#e74c3c',
        '#1abc9c', '#2980b9', '#f39c12', '#27ae60'
    ];

    <% if (rapoarte.length > 0) { %>

    // Chart global - agregate toate lunile per categorie
    const globalMap = {};
    <% rapoarte.forEach(r => { %>
        <% r.categorii.forEach(c => { %>
            if (!globalMap['<%= c.categorie %>']) globalMap['<%= c.categorie %>'] = 0;
            globalMap['<%= c.categorie %>'] += <%= c.cheltuit %>;
        <% }) %>
    <% }) %>

    const globalLabels = Object.keys(globalMap);
    const globalData = Object.values(globalMap);

    new Chart(document.getElementById('chartGlobal'), {
        type: 'doughnut',
        data: {
            labels: globalLabels,
            datasets: [{
                data: globalData,
                backgroundColor: CULORI.slice(0, globalLabels.length),
                borderWidth: 2,
                borderColor: borderColor
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            cutout: '60%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: textColor,
                        font: { size: 12, family: 'Inter, sans-serif' },
                        padding: 14,
                        boxWidth: 12
                    }
                },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.label}: ${ctx.parsed.toFixed(2)} lei`
                    }
                }
            }
        }
    });

    // Charturi per luna
    <% rapoarte.forEach((r, i) => { %>
    new Chart(document.getElementById('chart-<%= i %>'), {
        type: 'doughnut',
        data: {
            labels: [<% r.categorii.forEach((c, ci) => { %>'<%= c.categorie %>'<% if (ci < r.categorii.length - 1) { %>,<% } %><% }) %>],
            datasets: [{
                data: [<% r.categorii.forEach((c, ci) => { %><%= c.cheltuit %><% if (ci < r.categorii.length - 1) { %>,<% } %><% }) %>],
                backgroundColor: CULORI.slice(0, <%= r.categorii.length %>),
                borderWidth: 2,
                borderColor: borderColor
            }]
        },
        options: {
            cutout: '55%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.label}: ${ctx.parsed.toFixed(2)} lei`
                    }
                }
            }
        }
    });
    <% }) %>

    <% } %>

    function toggleRaport(i) {
        const body = document.getElementById('raport-' + i);
        const chevron = document.getElementById('chevron-' + i);
        const open = body.classList.toggle('open');
        chevron.classList.toggle('open');
        const btn = chevron.closest('.raport-header');
        if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function toggleNav(btn) {
        const nav = document.getElementById('topbarNav');
        const open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
</script>

</body>
</html>
