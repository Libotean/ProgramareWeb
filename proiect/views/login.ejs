<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autentificare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="center-page">
    <div class="form-card">
        <h2>Bun venit inapoi</h2>
        <p class="subtitle">Intra in contul tau.</p>
        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>
        <form method="POST" action="/login">
            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" placeholder="email@exemplu.com" required>
            </div>
            <div class="mb-3">
                <label>Parola</label>
                <input type="password" name="password" class="form-control" placeholder="parola ta" required>
            </div>
            <button type="submit" class="btn-submit">Intra in cont</button>
        </form>
        <div class="bottom-link">Nu ai cont? <a href="/register">Iregistreaza-te</a></div>
    </div>
</body>
</html>